+// anet.chat font setup (v16) — keep Virgil for English, swap Xiaolai → ShouShuTi for CJK
+//
+// User spec: 英文 Virgil, 中文 ShouShuTi.
+// We achieve this by:
+//
+//  (a) Register ShouShuTi (named both "ShouShuTi" AND "Xiaolai") via FontFace
+//      with unicode-range scoped to CJK so it only matches Chinese glyphs.
+//      `display: 'block'` forces the browser to wait for our font on first paint.
+//
+//  (b) Hook CanvasRenderingContext2D.font setter. Excalidraw assigns
+//      `ctx.font = "20px Virgil, Xiaolai, sans-serif"` when rendering CJK
+//      text. We rewrite ONLY "Xiaolai" → "ShouShuTi" (the registered
+//      family name), leaving Virgil / Excalifont / Cascadia untouched.
+//      English glyphs stay in Virgil; Chinese fallback goes to ShouShuTi.
+//
+//  (c) After fonts ready, call document.fonts.ready then trigger any
+//      mounted excalidrawAPI.refresh() so first-paint glitches are fixed.
+;(function setupAnetFonts() {
+  try {
+    const FF = (window as any).FontFace
+    if (!FF || !document?.fonts) return
+
+    // (a) Register ShouShuTi under BOTH names — same .ttf, both scoped to CJK
+    const cjkRange = "U+4E00-9FFF, U+3000-303F, U+FF00-FFEF, U+3400-4DBF, U+2E80-2EFF"
+    for (const name of ["ShouShuTi", "Xiaolai"]) {
+      const ff = new FF(
+        name,
+        "url(/fonts/ShouShuTi.ttf) format('truetype')",
+        { unicodeRange: cjkRange, display: "block" },
+      )
+      ff.load().then((loaded: FontFace) => {
+        document.fonts.add(loaded)
+        console.log(`[anet] ${name} font face added (CJK-scoped)`)
+      }).catch((e: unknown) => console.warn(`[anet] ${name} load failed:`, e))
+    }
+
+    // (b) Hook ctx.font setter — ALWAYS append ", ShouShuTi" as the final
+    //     CJK fallback. Critical insight from Excalidraw source:
+    //     getFontFamilyFallbacks() in @excalidraw/common ONLY adds Xiaolai
+    //     for fontFamily=5 (Excalifont). For Virgil (1), Cascadia (3), etc.
+    //     the resulting ctx.font has NO Xiaolai — so a "replace Xiaolai"
+    //     hook had nothing to match. The robust fix is to UNIVERSALLY
+    //     append our ShouShuTi to every ctx.font, regardless of what
+    //     Excalidraw set. Browser font fallback uses ShouShuTi only when
+    //     the earlier fonts (Virgil/Excalifont) have no glyph for the
+    //     codepoint — i.e. CJK characters only. English keeps Virgil.
+    function hookFontProto(proto: any, label: string) {
+      if (!proto || proto.__anetFontHooked) return
+      const desc = Object.getOwnPropertyDescriptor(proto, "font")
+      if (!desc?.set) return
+      const originalSet = desc.set
+      let logsLeft = 30
+      Object.defineProperty(proto, "font", {
+        configurable: true,
+        get: desc.get,
+        set(value: any) {
+          if (typeof value === "string") {
+            // Replace Xiaolai with ShouShuTi (covers Excalifont's CJK chain)
+            // AND unconditionally append ", ShouShuTi" as last fallback
+            // (covers Virgil and any other family that lacks Xiaolai).
+            let rewritten = value.replace(/(['"]?)Xiaolai\1/g, "ShouShuTi")
+            if (!/\bShouShuTi\b/.test(rewritten)) {
+              rewritten = rewritten + ", ShouShuTi"
+            }
+            if (logsLeft > 0 && rewritten !== value) {
+              console.log("[anet font hook]", value, "→", rewritten)
+              logsLeft--
+            }
+            value = rewritten
+          }
+          originalSet.call(this, value)
+        },
+      })
+      proto.__anetFontHooked = true
+      console.log(`[anet] font hook installed on ${label}`)
+    }
