+
+// anet.chat: load pre-baked Excalidraw libraries from /libraries/*.excalidrawlib
+// The files are baked into the canvas Docker image (frontend/public/libraries/).
+// On mount, we fetch each one as a Blob and feed it to excalidrawAPI.updateLibrary().
+// `merge: true` so user-added libraries are not clobbered if the user later adds more.
+const PREBAKED_LIBRARIES = [
+  'software-architecture.excalidrawlib',
+  'aws-simple-icons.excalidrawlib',
+  'azure-cloud-services.excalidrawlib',
+  'information-architecture.excalidrawlib',
+  'lo-fi-wireframing-kit.excalidrawlib',
+  'stick-figures.excalidrawlib',
+]
+async function loadPreBakedLibraries(api: ExcalidrawImperativeAPI): Promise<void> {
+  for (const fname of PREBAKED_LIBRARIES) {
+    try {
+      const resp = await fetch(`/libraries/${fname}`)
+      if (!resp.ok) {
+        console.warn(`[anet] library ${fname}: HTTP ${resp.status}`)
+        continue
+      }
+      const blob = await resp.blob()
+      await api.updateLibrary({
+        libraryItems: blob,
+        merge: true,
+        openLibraryMenu: false,
+        defaultStatus: 'published',
+      })
+      console.log(`[anet] loaded library: ${fname}`)
+    } catch (e) {
+      console.warn(`[anet] library ${fname} failed:`, e)
+    }
+  }
+}
