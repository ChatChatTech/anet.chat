+// "Xiaolai" (see CJK_HAND_DRAWN_FALLBACK_FONT in @excalidraw/common).
+// Excalidraw lazily downloads HUNDREDS of `Xiaolai-Regular-<hash>.woff2`
+// subset files keyed by unicode range — we can't replace them all. Trick:
+// add a single FontFace with the full CJK unicode-range FIRST. When
+// Excalidraw later requests its subset for a particular character,
+// browser already has a face that covers it → no extra fetch needed,
+// and our ShouShuTi glyph wins.
+//
+// This runs at module import (before React mounts), so it's race-stable.
+;(function preloadShouShuTi() {
+  try {
+    const FF = (window as any).FontFace
+    if (!FF || !document?.fonts) return
+    const ff = new FF(
+      "Xiaolai",
+      "url(/fonts/ShouShuTi.ttf) format('truetype')",
+      {
+        unicodeRange: "U+4E00-9FFF, U+3000-303F, U+FF00-FFEF, U+3400-4DBF, U+2E80-2EFF",
+        display: "swap",
+      },
+    )
+    ff.load().then((loaded: FontFace) => {
+      document.fonts.add(loaded)
+      console.log("[anet] ShouShuTi pre-registered under 'Xiaolai' name")
+    }).catch((e: unknown) => console.warn("[anet] ShouShuTi preload failed:", e))
+    // Also register under "ShouShuTi" explicit name for any future use.
+    const ff2 = new FF("ShouShuTi", "url(/fonts/ShouShuTi.ttf) format('truetype')",
+                      { display: "swap" })
+    ff2.load().then((loaded: FontFace) => document.fonts.add(loaded)).catch(() => {})
+  } catch (e) {
+    console.warn("[anet] font preload outer error:", e)
